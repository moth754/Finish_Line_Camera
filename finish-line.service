# systemd unit to run the finish-line capture system on boot.
#
# Install:
#   sudo cp /home/dartdata/finish_line_camera/finish-line.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now finish-line.service
#
# Watch the logs:
#   journalctl -u finish-line.service -f
#
# Stop / restart:
#   sudo systemctl stop finish-line.service
#   sudo systemctl restart finish-line.service

[Unit]
Description=Finish Line Capture System
# Wait for the network so the dashboard is reachable over the LAN.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dartdata
Group=dartdata
WorkingDirectory=/home/dartdata/finish_line_camera

# System Python is used on purpose: picamera2 is a system (apt) package, and the
# extra pip packages (opencv, pytesseract) live in the user's ~/.local site,
# which Python picks up automatically because the service runs as User=dartdata.
ExecStart=/usr/bin/python3 run.py

# Flush stdout/stderr straight to the journal (no buffering) so logs are live.
Environment=PYTHONUNBUFFERED=1

# Restart if it ever crashes (e.g. started a touch too early at boot).
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
